# OAuth sozlamalari. Bu qiymatlar BO'SH bo'lsa, login MOCK (demo) rejimda ishlaydi.
# Real provider ma'lumotlari to'ldirilgach, mock avtomatik o'chadi.

# API backend (token almashinuvi backendga ko'chsa)
VITE_API_BASE_URL=/

# Callback manzili (provider whitelist'iga qo'shilgan bo'lishi shart)
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/callback

# --- HEMIS (Staff & Student bitta provider, ikki client_id) ---
VITE_HEMIS_AUTHORIZE_URL=
VITE_HEMIS_TOKEN_URL=
VITE_HEMIS_USERINFO_URL=
VITE_HEMIS_STAFF_CLIENT_ID=
VITE_HEMIS_STUDENT_CLIENT_ID=
VITE_HEMIS_SCOPE=profile

# --- OneID ---
VITE_ONEID_AUTHORIZE_URL=
VITE_ONEID_TOKEN_URL=
VITE_ONEID_USERINFO_URL=
VITE_ONEID_CLIENT_ID=
VITE_ONEID_SCOPE=openid profile
